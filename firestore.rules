rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get sanitized email from user email
    function getSanitizedEmail(email) {
      return email.replace('.', '_dot_').replace('@', '_at_').replace('/', '_').replace('[', '_').replace(']', '_').replace('*', '_').replace('?', '_');
    }
    
    // Helper function to check if user owns the data
    function isOwner(userEmail) {
      return request.auth != null && 
             request.auth.token.email != null && 
             getSanitizedEmail(request.auth.token.email) == userEmail;
    }
    
    // Allow authenticated users to access their own user document
    match /users/{userEmail} {
      allow read, write: if isOwner(userEmail);
      
      // Allow users to access their own devices
      match /devices/{deviceId} {
        allow read, write: if isOwner(userEmail);
        
        // Location data
        match /locations/{locationId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Call logs
        match /call_logs/{callId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Messages
        match /messages/{messageId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Contacts
        match /contacts/{contactId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Audio recordings
        match /audio_recordings/{recordingId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Weather data
        match /weather/{weatherId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Phone state
        match /phone_state/{stateId} {
          allow read, write: if isOwner(userEmail);
        }
        
        // Any other subcollections under devices
        match /{collection}/{document} {
          allow read, write: if isOwner(userEmail);
        }
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
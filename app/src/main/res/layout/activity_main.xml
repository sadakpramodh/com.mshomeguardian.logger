<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device ID: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/accountInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/permissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Permissions"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/healthConnectStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/health_connect_not_connected"
            android:textSize="14sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/connectHealthButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_google_health"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/syncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync Now"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/recordingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Audio Recording"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Live Transcription Button -->
        <Button
            android:id="@+id/liveTranscriptionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Transcription"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/signOutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_out"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You can close this app and the monitoring will continue in the background."
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>